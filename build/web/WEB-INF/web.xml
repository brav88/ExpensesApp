<?xml version="1.0" encoding="UTF-8"?>
<web-app version="3.1" xmlns="http://xmlns.jcp.org/xml/ns/javaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">
    <servlet>
        <servlet-name>loginServlet</servlet-name>
        <servlet-class>expenses.access.module.loginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>expensesServlet</servlet-name>
        <servlet-class>expenses.manage.module.expensesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>saveExpense</servlet-name>
        <servlet-class>expenses.manage.module.saveExpense</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>loadExpenseServlet</servlet-name>
        <servlet-class>expenses.manage.module.loadExpenseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>updateExpenseServlet</servlet-name>
        <servlet-class>expenses.manage.module.updateExpenseServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>deleteExpenseServlet</servlet-name>
        <servlet-class>expenses.manage.module.deleteExpenseServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>loginServlet</servlet-name>
        <url-pattern>/loginServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>expensesServlet</servlet-name>
        <url-pattern>/expensesServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>saveExpense</servlet-name>
        <url-pattern>/saveExpense</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>loadExpenseServlet</servlet-name>
        <url-pattern>/loadExpenseServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>updateExpenseServlet</servlet-name>
        <url-pattern>/updateExpenseServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>deleteExpenseServlet</servlet-name>
        <url-pattern>/deleteExpenseServlet</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
